---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const allProjects = await getCollection('projects');

// Filter to only published projects
const publishedProjects = allProjects.filter((p) => p.data.published !== false);

// Sort by date descending
publishedProjects.sort((a, b) => {
  const dateA = a.data.date ? new Date(a.data.date).getTime() : 0;
  const dateB = b.data.date ? new Date(b.data.date).getTime() : 0;
  return dateB - dateA;
});

// Option C Hybrid: Featured hero project + 2-column secondary grid
const featuredProject = publishedProjects.find((p) => p.data.featured) || publishedProjects[0];
const secondaryProjects = publishedProjects.filter((p) => p.id !== featuredProject?.id);

// Card background tint themes inspired by Buzz Usborne
const tintThemes = ['tint-clay', 'tint-sage', 'tint-slate', 'tint-warm'];
---

<Layout>
  <!-- Hero Statement Section -->
  <section class="hero-section">
    <h1 class="hero-statement">
      I'm a product designer who craft digital experiences that turn complexity into clarity, helping users navigate products with confidence and delight.
    </h1>
    <div class="hero-subtext">
      <p>Based in Singapore &bull; Working with global teams across product strategy, design systems, and interaction design.</p>
    </div>
    <div class="hero-scroll-cue">
      <span>Selected work &darr;</span>
    </div>
  </section>

  <!-- Projects Showcase (Option C: Hybrid Rhythm) -->
  <section class="showcase-section">
    {featuredProject && (
      <div class="featured-wrapper">
        <a href={`/projects/${featuredProject.id}`} class="featured-card">
          <div class="featured-media tint-warm">
            {featuredProject.data.coverImage ? (
              <img src={featuredProject.data.coverImage} alt={featuredProject.data.title} />
            ) : (
              <div class="abstract-visual">
                <div class="device-mockup">
                  <div class="mockup-header">
                    <span class="dot"></span>
                    <span class="dot"></span>
                    <span class="dot"></span>
                  </div>
                  <div class="mockup-body">
                    <div class="mockup-line w-70"></div>
                    <div class="mockup-grid">
                      <div class="mockup-box"></div>
                      <div class="mockup-box"></div>
                      <div class="mockup-box"></div>
                    </div>
                  </div>
                </div>
              </div>
            )}
          </div>
          <div class="featured-content">
            <div class="meta-row">
              <span class="project-category">{featuredProject.data.category}</span>
              {featuredProject.data.date && (
                <span class="project-year">
                  {new Date(featuredProject.data.date).getFullYear()}
                </span>
              )}
            </div>
            <h2 class="featured-title">{featuredProject.data.title}</h2>
            {featuredProject.data.description && (
              <p class="featured-desc">{featuredProject.data.description}</p>
            )}
          </div>
        </a>
      </div>
    )}

    <!-- Secondary 2-Column Grid -->
    {secondaryProjects.length > 0 && (
      <div class="secondary-grid">
        {secondaryProjects.map((project, index) => {
          const tintClass = tintThemes[index % tintThemes.length];
          return (
            <a href={`/projects/${project.id}`} class="grid-card">
              <div class={`grid-media ${tintClass}`}>
                {project.data.coverImage ? (
                  <img src={project.data.coverImage} alt={project.data.title} />
                ) : (
                  <div class="grid-placeholder">
                    <div class="card-sketch">
                      <div class="sketch-line"></div>
                      <div class="sketch-line short"></div>
                    </div>
                  </div>
                )}
              </div>
              <div class="grid-content">
                <div class="meta-row">
                  <span class="project-category">{project.data.category}</span>
                  {project.data.date && (
                    <span class="project-year">
                      {new Date(project.data.date).getFullYear()}
                    </span>
                  )}
                </div>
                <h3 class="grid-title">{project.data.title}</h3>
                {project.data.description && (
                  <p class="grid-desc">{project.data.description}</p>
                )}
              </div>
            </a>
          );
        })}
      </div>
    )}
  </section>
</Layout>

<style>
  /* Hero Section */
  .hero-section {
    padding: 2.5rem 0 4.5rem;
  }

  .hero-statement {
    font-size: 2.25rem;
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: -0.03em;
    color: var(--color-text);
    margin-bottom: 1.5rem;
  }

  .hero-scroll-cue {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-transform: lowercase;
    letter-spacing: -0.01em;
  }

  @media (min-width: 640px) {
    .hero-statement {
      font-size: 2.75rem;
      line-height: 1.3;
    }
  }

  .hero-subtext {
    font-size: 1.05rem;
    color: var(--color-text-muted);
    max-width: 60ch;
    line-height: 1.6;
    margin-bottom: 3.5rem;
  }

  /* Featured Project Hero Card (Option C) */
  .showcase-section {
    display: flex;
    flex-direction: column;
    gap: 3rem;
  }

  .featured-wrapper {
    width: 100%;
  }

  .featured-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .featured-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-border-hover);
    box-shadow: 0 16px 36px -12px rgba(28, 25, 23, 0.08);
  }

  .featured-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--color-border);
  }

  .featured-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .featured-card:hover .featured-media img {
    transform: scale(1.02);
  }

  .featured-content {
    padding: 2.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  @media (min-width: 768px) {
    .featured-content {
      padding: 2.75rem;
    }
  }

  .meta-row {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.25rem;
  }

  .project-category,
  .project-year {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--color-text-muted);
  }

  .project-category {
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }

  .featured-title {
    font-size: 1.65rem;
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--color-text);
    line-height: 1.3;
    transition: color 0.2s ease;
  }

  .featured-card:hover .featured-title,
  .grid-card:hover .grid-title {
    color: #0F172A;
  }

  .featured-desc {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
    max-width: 68ch;
  }

  /* Secondary 2-Column Grid */
  .secondary-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media (min-width: 640px) {
    .secondary-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .grid-card {
    display: flex;
    flex-direction: column;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    overflow: hidden;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
  }

  .grid-card:hover {
    transform: translateY(-4px);
    border-color: var(--color-border-hover);
    box-shadow: 0 14px 30px -10px rgba(28, 25, 23, 0.07);
  }

  .grid-media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    border-bottom: 1px solid var(--color-border);
  }

  .grid-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .grid-card:hover .grid-media img {
    transform: scale(1.02);
  }

  .grid-content {
    padding: 1.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    flex: 1;
  }

  .grid-title {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.35;
    color: var(--color-text);
  }

  .grid-desc {
    font-size: 0.925rem;
    color: var(--color-text-secondary);
    line-height: 1.55;
  }

  /* Tactile Tint Palettes inspired by Buzz Usborne */
  .tint-warm {
    background: #F4EFEB;
  }

  .tint-clay {
    background: #F1ECE6;
  }

  .tint-sage {
    background: #EDF1EC;
  }

  .tint-slate {
    background: #EDF0F3;
  }

  /* Abstract Placeholder Visuals */
  .abstract-visual {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .device-mockup {
    width: 78%;
    max-width: 420px;
    background: #FFFFFF;
    border-radius: 12px;
    border: 1px solid rgba(28, 25, 23, 0.08);
    box-shadow: 0 12px 24px -8px rgba(28, 25, 23, 0.08);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    transition: transform 0.3s ease;
  }

  .featured-card:hover .device-mockup {
    transform: translateY(-2px) scale(1.01);
  }

  .mockup-header {
    display: flex;
    gap: 6px;
  }

  .mockup-header .dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #E5E0D8;
  }

  .mockup-body {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .mockup-line {
    height: 8px;
    border-radius: 4px;
    background: #EFEBE4;
  }

  .mockup-line.w-70 {
    width: 65%;
  }

  .mockup-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.75rem;
    margin-top: 0.25rem;
  }

  .mockup-box {
    aspect-ratio: 1;
    background: #F7F5F0;
    border-radius: 6px;
  }

  .grid-placeholder {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .card-sketch {
    width: 55%;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1.25rem;
    background: #FFFFFF;
    border-radius: 8px;
    box-shadow: 0 6px 16px -6px rgba(28, 25, 23, 0.06);
    border: 1px solid rgba(28, 25, 23, 0.06);
  }

  .sketch-line {
    height: 6px;
    background: #EFEBE4;
    border-radius: 3px;
    width: 100%;
  }

  .sketch-line.short {
    width: 55%;
  }
</style>
