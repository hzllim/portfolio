---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const aboutEntries = await getCollection('about');
const about = aboutEntries.length > 0 ? aboutEntries[0] : null;
const { Content } = about ? await render(about) : { Content: null };
---

<Layout
  title="About • Hazel"
  description="Learn more about Hazel, product designer crafting thoughtful digital experiences."
>
  <div class="about-wrapper">
    <header class="about-hero">
      <div class="avatar-container">
        {about?.data.avatar && (
          <img src={about.data.avatar} alt={about.data.name || 'Hazel'} class="avatar-img" />
        )}
      </div>

      <div class="hero-titles">
        <span class="about-kicker">About</span>
        <h1 class="about-name">{about?.data.name || 'Hazel'}</h1>
        <p class="about-tagline">{about?.data.tagline || 'Product Designer'}</p>
        <p class="about-loc">Based in Singapore &bull; Working globally</p>
      </div>
    </header>

    <section class="about-prose">
      {Content ? <Content /> : <p>Welcome to my portfolio!</p>}
    </section>
  </div>
</Layout>

<style>
  .about-wrapper {
    max-width: 760px;
    margin: 0 auto;
  }

  .about-hero {
    display: grid;
    grid-template-columns: 1fr minmax(140px, 180px);
    align-items: end;
    gap: clamp(2rem, 8vw, 5rem);
    padding: 1rem 0 4rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 4rem;
  }

  .avatar-container {
    flex-shrink: 0;
    grid-column: 2;
    grid-row: 1;
  }

  .avatar-img {
    width: 100%;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius-sm);
    object-fit: cover;
  }

  .hero-titles {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    grid-column: 1;
    grid-row: 1;
  }

  .about-kicker {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-text-secondary);
    letter-spacing: -0.01em;
    text-transform: lowercase;
  }

  .about-name {
    font-size: clamp(2.25rem, 4vw, 3rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.3;
    color: var(--color-text);
  }

  .about-tagline {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    max-width: 32ch;
  }

  .about-loc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  /* Bio Prose */
  .about-prose {
    max-width: 620px;
    font-size: 1.15rem;
    line-height: 1.75;
    color: #383431;
    margin: 0;
    padding: 0 0 1rem;
  }

  .about-prose :global(p) {
    margin-bottom: 1.75rem;
  }

  @media (max-width: 640px) {
    .about-hero {
      grid-template-columns: 1fr;
      gap: 2rem;
      padding-bottom: 3rem;
      margin-bottom: 3rem;
    }

    .avatar-container {
      grid-column: 1;
      grid-row: 1;
      max-width: 150px;
    }

    .hero-titles {
      grid-column: 1;
      grid-row: 2;
    }

    .about-name {
      font-size: 2.25rem;
    }

    .about-prose {
      font-size: 1.1rem;
    }
  }
</style>
