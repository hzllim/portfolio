---
import Layout from '../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

const aboutEntries = await getCollection('about');
const about = aboutEntries.length > 0 ? aboutEntries[0] : null;
const { Content } = about ? await render(about) : { Content: null };
---

<Layout
  title="About • Hazel"
  description="Learn more about Hazel, product designer crafting thoughtful digital experiences."
>
  <div class="about-wrapper">
    <!-- Header -->
    <header class="about-hero">
      <div class="avatar-container">
        {about?.data.avatar ? (
          <img src={about.data.avatar} alt={about.data.name || 'Hazel'} class="avatar-img" />
        ) : (
          <div class="avatar-monogram">
            <span>R</span>
          </div>
        )}
      </div>

      <div class="hero-titles">
        <h1 class="about-name">{about?.data.name || 'Hazel'}</h1>
        <p class="about-tagline">{about?.data.tagline || 'Product Designer'}</p>
        <p class="about-loc">📍 Based in Singapore &bull; Working globally</p>
      </div>
    </header>

    <!-- Bio Body -->
    <div class="about-prose">
      {Content ? <Content /> : <p>Welcome to my portfolio!</p>}
    </div>

    <!-- Career / Experience Highlights (Editorial list) -->
    <section class="experience-section">
      <h2 class="section-heading">Background &amp; Focus</h2>
      <div class="exp-list">
        <div class="exp-item">
          <div class="exp-meta">
            <span class="exp-role">Product Design Lead</span>
            <span class="exp-time">2023 — Present</span>
          </div>
          <p class="exp-desc">Directing end-to-end design strategy, design systems, and cross-functional design sprints for consumer &amp; SaaS platforms.</p>
        </div>

        <div class="exp-item">
          <div class="exp-meta">
            <span class="exp-role">Senior UI/UX Designer</span>
            <span class="exp-time">2020 — 2023</span>
          </div>
          <p class="exp-desc">Led core product revamps, iterative usability testing, and interactive prototyping from early concept to production.</p>
        </div>

        <div class="exp-item">
          <div class="exp-meta">
            <span class="exp-role">Product &amp; Visual Designer</span>
            <span class="exp-time">2018 — 2020</span>
          </div>
          <p class="exp-desc">Designed brand identities, responsive web apps, and design systems for emerging technology startups.</p>
        </div>
      </div>
    </section>

    <!-- Connect / Links -->
    <section class="connect-section">
      <h2 class="section-heading">Connect</h2>
      <p class="connect-text">Feel free to reach out for advisory, design leadership, or project inquiries.</p>
      <div class="connect-buttons">
        {about?.data.email && (
          <a href={`mailto:${about.data.email}`} class="connect-pill primary">Say Hello &rarr;</a>
        )}
        {about?.data.socialLinks && about.data.socialLinks.map((link) => {
          const href = link.url.startsWith('http://') || link.url.startsWith('https://') || link.url.startsWith('mailto:') ? link.url : `https://${link.url}`;
          return (
            <a href={href} target="_blank" rel="noopener noreferrer" class="connect-pill">
              {link.platform} ↗
            </a>
          );
        })}
      </div>
    </section>
  </div>
</Layout>

<style>
  .about-wrapper {
    max-width: 720px;
    margin: 0 auto;
    padding-top: 1rem;
  }

  .about-hero {
    display: flex;
    align-items: center;
    gap: 2rem;
    padding-bottom: 2.5rem;
    border-bottom: 1px solid var(--color-border);
    margin-bottom: 3rem;
  }

  .avatar-container {
    flex-shrink: 0;
  }

  .avatar-img {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    object-fit: cover;
    border: 2px solid var(--color-border);
  }

  .avatar-monogram {
    width: 96px;
    height: 96px;
    border-radius: 50%;
    background: var(--color-surface);
    border: 2px solid var(--color-border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 2rem;
    font-weight: 800;
    color: var(--color-text);
  }

  .hero-titles {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .about-name {
    font-size: 2.25rem;
    font-weight: 800;
    letter-spacing: -0.02em;
    line-height: 1.2;
    color: var(--color-text);
  }

  .about-tagline {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
  }

  .about-loc {
    font-size: 0.875rem;
    color: var(--color-text-muted);
  }

  /* Bio Prose */
  .about-prose {
    font-size: 1.15rem;
    line-height: 1.8;
    color: #383431;
    margin-bottom: 3.5rem;
  }

  .about-prose :global(p) {
    margin-bottom: 1.5rem;
  }

  /* Experience Section */
  .experience-section {
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-border);
    margin-bottom: 3.5rem;
  }

  .section-heading {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--color-text);
    margin-bottom: 1.75rem;
  }

  .exp-list {
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }

  .exp-item {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .exp-meta {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
  }

  .exp-role {
    font-size: 1.05rem;
    font-weight: 600;
    color: var(--color-text);
  }

  .exp-time {
    font-family: var(--font-mono);
    font-size: 0.825rem;
    color: var(--color-text-muted);
  }

  .exp-desc {
    font-size: 0.95rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  /* Connect Section */
  .connect-section {
    padding-top: 2.5rem;
    border-top: 1px solid var(--color-border);
  }

  .connect-text {
    font-size: 1.05rem;
    color: var(--color-text-secondary);
    margin-bottom: 1.5rem;
  }

  .connect-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
  }

  .connect-pill {
    padding: 0.6rem 1.25rem;
    border-radius: var(--radius-pill);
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--color-text);
    transition: all 0.2s ease;
  }

  .connect-pill:hover {
    border-color: var(--color-text);
    transform: translateY(-2px);
  }

  .connect-pill.primary {
    background: var(--color-text);
    color: var(--color-bg);
    border-color: var(--color-text);
  }

  .connect-pill.primary:hover {
    opacity: 0.92;
  }
</style>
