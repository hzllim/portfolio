---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Page Not Found | 404">
  <script is:inline>
    // GitHub Pages SPA router fallback:
    // If the user refreshed on a sub-path like /keystatic/collection/projects,
    // redirect to /keystatic and restore the intended route.
    const path = window.location.pathname;
    if (path.includes('/keystatic/')) {
      sessionStorage.setItem('keystatic_redirect', path);
      window.location.replace('/keystatic');
    }
  </script>

  <div class="not-found">
    <h1 class="code">404</h1>
    <h2 class="title">Page Not Found</h2>
    <p class="description">
      The page you're looking for doesn't exist or has been moved.
    </p>
    <a href="/" class="home-btn">&larr; Return Home</a>
  </div>
</Layout>

<style>
  .not-found {
    text-align: center;
    padding: 5rem 1rem;
    max-width: 500px;
    margin: 0 auto;
  }

  .code {
    font-size: 5rem;
    font-weight: 900;
    color: var(--color-primary);
    line-height: 1;
    margin-bottom: 1rem;
  }

  .title {
    font-size: 1.75rem;
    font-weight: 700;
    margin-bottom: 0.75rem;
  }

  .description {
    color: var(--color-text-muted);
    margin-bottom: 2rem;
    font-size: 1.05rem;
  }

  .home-btn {
    display: inline-block;
    padding: 0.8rem 1.6rem;
    background: var(--color-primary);
    color: white;
    border-radius: 8px;
    font-weight: 600;
    transition: background-color 0.2s ease;
  }

  .home-btn:hover {
    background: var(--color-primary-hover);
  }
</style>

