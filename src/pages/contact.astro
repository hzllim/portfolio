---
import Layout from '../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const aboutEntries = await getCollection('about');
const aboutData = aboutEntries.length > 0 ? aboutEntries[0].data : null;
const contactEmail = aboutData?.email || 'hello@example.com';
const authorName = aboutData?.name || 'Hazel';
---

<Layout
  title={`Contact • ${authorName}`}
  description="Get in touch for product design, design systems, and advisory opportunities."
>
  <div class="contact-wrapper">
    <header class="contact-header">
      <h1 class="contact-title">Let's build something thoughtful.</h1>
      <p class="contact-subtext">
        Whether you have a new project, design advisory needs, or just want to chat about product design, my inbox is open.
      </p>
    </header>

    <div class="contact-box">
      <!-- Direct Email Shortcut -->
      <div class="direct-email-card">
        <span class="card-label">Direct Email</span>
        <a href={`mailto:${contactEmail}`} class="email-link">
          {contactEmail} &rarr;
        </a>
      </div>
    </div>
  </div>
</Layout>

<style>
  .contact-wrapper {
    max-width: 640px;
    margin: 0 auto;
    padding-top: 1rem;
  }

  .contact-header {
    margin-bottom: 2.75rem;
  }

  .contact-title {
    font-size: 2.5rem;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1.2;
    color: var(--color-text);
    margin-bottom: 1rem;
  }

  .contact-subtext {
    font-size: 1.1rem;
    color: var(--color-text-secondary);
    line-height: 1.6;
  }

  .contact-box {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
  }

  .direct-email-card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    transition: border-color 0.2s ease, transform 0.2s ease;
  }

  .direct-email-card:hover {
    border-color: var(--color-border-hover);
    transform: translateY(-2px);
  }

  .card-label {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-text-muted);
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .email-link {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.01em;
  }
</style>
